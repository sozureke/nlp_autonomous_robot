# Copy: cp .env.local.example .env.local
# Uncomment exactly ONE of the variables below (never both proxy + public base).
# Restart `yarn dev` after any change.

# --- Proxy (default for Pi + laptop): browser → Next `/api/*` → FastAPI ---
# ROBOT_API_REWRITE_TARGET=http://192.168.0.45:8000

# --- Direct: browser → FastAPI (set WEB_CORS_ORIGINS on the API for this origin) ---
# NEXT_PUBLIC_ROBOT_API_BASE=http://192.168.0.45:8000

# --- API on the same machine as Next (local dev) ---
# ROBOT_API_REWRITE_TARGET=http://127.0.0.1:8000
